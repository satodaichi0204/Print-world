<!-- Header FOUC guard: ヘッダーのレイアウトは外部CSS(非同期)にあるため、効く前に一瞬
     (1)PC版の赤=お問い合わせ/緑=LINE のフラッシュ、(2)SPアイコンの整列前レイアウト(縦ズレ) が出る。
     styles.css が適用され .fv-header が position:fixed になるまでヘッダーを隠し、その瞬間に一度だけ表示して両方を防ぐ。
     キャッシュ済み遷移では即時に表示されるため体感差はない。pinPwCss の貼り替えにも耐性(再適用まで待つ)。 -->
<style>
  .fv-header { visibility: hidden; }
  html.pw-hdr-ready .fv-header { visibility: visible; }
</style>
<script>
(function () {
  var t0 = Date.now();
  function reveal() { document.documentElement.classList.add("pw-hdr-ready"); }
  function ready() {
    var h = document.querySelector(".fv-header");
    if (!h || getComputedStyle(h).position !== "fixed") return false;   // styles.css 適用前
    /* PC版(.fv-header__main)を隠すのは mobile.css 側。styles.css だけ先に効くと
       position:fixed でも PC版が残るため、スマホでは main が display:none に
       なる(=mobile.css 適用)まで表示を待つ。 */
    if (window.matchMedia("(max-width: 768px)").matches) {
      var main = h.querySelector(".fv-header__main");
      if (main && getComputedStyle(main).display !== "none") return false; // mobile.css 未適用
    }
    return true;
  }
  (function poll() {
    if (ready()) return reveal();
    if (Date.now() - t0 > 5000) return reveal();                        // 安全弁(隠したままにしない)
    requestAnimationFrame(poll);
  })();
})();
</script>
