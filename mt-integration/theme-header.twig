        "@media only screen and (max-width:959px){" +
        "html body:has(.header__checkout) main{padding-top:106px!important;}" +
        "}";
    if (!s) {
      s = document.createElement("style");
      s.id = id;
      s.setAttribute("data-pw-lock", CSS_V);
      s.textContent = css;
      head.appendChild(s);
      return;
    }
    if (s.getAttribute("data-pw-lock") !== CSS_V) {
      s.setAttribute("data-pw-lock", CSS_V);
      s.textContent = css;
    }
    if (s.parentNode !== head || head.lastElementChild !== s) {
      head.appendChild(s);
    }
  }

  /* All pages: force Noto Sans JP (AI data default) so MT body* cannot fall back to Helvetica / ヒラギノ.
     Always rewrite #pw-site-type-lock and keep it last in <head>. */
  function pinSiteTypeLock() {
    var id = "pw-site-type-lock";
    var head = document.head || document.documentElement;
    var s = document.getElementById(id);
    var f =
      "'Noto Sans JP','Hiragino Kaku Gothic ProN','Hiragino Sans','Yu Gothic','Meiryo',sans-serif";
    var css =
      "html,body,body *:not(script):not(style){" +
      "font-family:" +
      f +
      "!important;}" +
      ".phone-box__number,.product-price,.plp-ranking__track .product-price,.plp-card__price,.pdp-spec__price,.mcPage__itemListContent-grid .itemListContent__price{" +
      "font-family:'Arial Black','Helvetica Neue',Arial,sans-serif!important;}" +
      ".pdp-spec__brand{font-family:'Times New Roman','Hiragino Mincho ProN',serif!important;}" +
      "body.info-page .bold,body.privacy-page .bold,.bold{font-weight:500!important;}" +
      "@media (max-width:768px){" +
      "body.info-page .bold,body.privacy-page .bold,.bold{font-weight:inherit!important;}" +
      "body.privacy-page .privacy-section h2{font-size:18px!important;font-weight:500!important;}" +
      "}";
    if (!s) {
      s = document.createElement("style");
      s.id = id;
      head.appendChild(s);
    }
    s.setAttribute("data-pw-lock", CSS_V);
    s.textContent = css;
    if (s.parentNode !== head || head.lastElementChild !== s) {
      head.appendChild(s);
    }
  }

  function markPlpBody() {
    var b = document.body;
    if (!b || b.classList.contains("product-detail-page")) return;
    if (b.querySelector(".plp-hero") || /products?-?list/i.test(location.pathname || "")) {
      b.classList.add("product-list-page");
    }
  }

  /* Inline !important survives late MT #id h1/span rules that beat class selectors. */
  function pinPlpHeroTitleSize() {
    var sms = document.querySelectorAll(".plp-hero__title-sm");
    var lgs = document.querySelectorAll(".plp-hero__title-lg");
    var titleEl = document.getElementById("plp-hero-title");
    if (!sms.length && !lgs.length) return;
    var smSize = "";
    var lgSize = "";
    if (window.matchMedia("(max-width: 425px)").matches) {
      smSize = "max(14px, calc(23px * var(--sp-header-s, 1)))";
      lgSize = smSize;
    } else if (window.matchMedia("(min-width: 426px) and (max-width: 768px)").matches) {
      smSize = "calc(33px * var(--sp-header-s, 1))";
      lgSize = smSize;
    }
    var i;
    if (!smSize) {
      for (i = 0; i < sms.length; i++) sms[i].style.removeProperty("font-size");
      for (i = 0; i < lgs.length; i++) lgs[i].style.removeProperty("font-size");
      if (titleEl) titleEl.style.removeProperty("font-size");
      return;
    }
    for (i = 0; i < sms.length; i++) sms[i].style.setProperty("font-size", smSize, "important");
    for (i = 0; i < lgs.length; i++) lgs[i].style.setProperty("font-size", lgSize, "important");
    if (titleEl) titleEl.style.setProperty("font-size", lgSize || smSize, "important");
  }

  function pinPlpInheritedWeights() {
    var body = document.body;
    if (!body) return;
    var root = body.querySelector(".plp-main");
    if (!root && !body.classList.contains("product-list-page")) return;
    if (!window.matchMedia("(max-width: 768px)").matches) {
      if (body.classList.contains("product-list-page")) {
        body.style.removeProperty("font-weight");
      }
      if (root) {
        root.style.removeProperty("font-weight");
        var desktopNodes = root.querySelectorAll("*");
        for (var j = 0; j < desktopNodes.length; j++) {
          desktopNodes[j].style.removeProperty("font-weight");
        }
      }
      return;
    }
    if (body.classList.contains("product-list-page")) {
      body.style.setProperty("font-weight", "400", "important");
    }
    if (root) root.style.setProperty("font-weight", "400", "important");
    var scope = root || body;
    var nodes = scope.querySelectorAll("*");
    for (var i = 0; i < nodes.length; i++) {
      nodes[i].style.setProperty("font-weight", "inherit", "important");
    }
  }

  /* PDP yellow title: lock family (and weight on PC only). Do not touch font-size. */
  function pinPdpHeroTitleStyle() {
    var el = document.getElementById("pdp-title") || document.querySelector(".pdp-hero__title");
    if (!el) return;
    if (window.matchMedia("(max-width: 768px)").matches) {
      el.style.setProperty("font-weight", "inherit", "important");
    } else {
      el.style.setProperty("font-weight", "900", "important");
    }
    el.style.setProperty(
      "font-family",
      '"Noto Sans JP", "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif',
      "important"
    );
    el.style.setProperty("color", "#111", "important");
    el.style.setProperty("letter-spacing", "0.02em", "important");
  }

  var PDP_INFO_FONT =
    '"Noto Sans JP", "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif';
  function pinPdpInfoStyle() {
    var info = document.querySelector(".pdp-info");
    if (!info) return;
    var mobileInherit = window.matchMedia("(max-width: 768px)").matches;
    function set(el, props) {
      if (!el) return;
      var k;
      for (k in props) el.style.setProperty(k, props[k], "important");
    }
    set(info.querySelector(".pdp-point__label"), {
      "font-family": PDP_INFO_FONT,
      "font-weight": mobileInherit ? "inherit" : "900",
      "font-size": "13px",
      padding: "14px 28px",
      "letter-spacing": "0.04em",
      "line-height": "1"
    });
    set(info.querySelector(".pdp-headline"), {
      "font-family": PDP_INFO_FONT,
      "font-weight": mobileInherit ? "inherit" : "900",
      "font-size": "28px",
      "line-height": "1.45"
    });
    var i;
    var ps = info.querySelectorAll(".pdp-desc p");
    for (i = 0; i < ps.length; i++) {
      set(ps[i], {
        "font-family": PDP_INFO_FONT,
        "font-weight": mobileInherit ? "inherit" : "700",
        "font-size": "14px"
      });
    }
    var cells = info.querySelectorAll(".pdp-spec th, .pdp-spec td");
    for (i = 0; i < cells.length; i++) {
      var isTh = cells[i].tagName === "TH";
      set(cells[i], {
        "font-family": PDP_INFO_FONT,
        padding: "16px 20px",
        "font-size": isTh ? "13px" : "14px",
        "font-weight": mobileInherit ? "inherit" : "700"
      });
    }
  }

  function pinAll() {
    if (pinning) return;
    pinning = true;
    try {
      pinPwCss();
      pinPlpRankingLock();
      pinSiteTypeLock();
      markPlpBody();
      pinPlpInheritedWeights();
      pinPlpHeroTitleSize();
      pinPdpHeroTitleStyle();
      pinPdpInfoStyle();
    } finally {
      pinning = false;
    }
  }

  pinAll();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", pinAll);
  }
  window.addEventListener("load", pinAll);
  window.addEventListener("resize", function () {
    pinPlpHeroTitleSize();
    pinPdpHeroTitleStyle();
    pinPdpInfoStyle();
  });
  setTimeout(pinAll, 0);
  setTimeout(pinAll, 300);
  setTimeout(pinAll, 1000);
  setTimeout(pinPlpInheritedWeights, 2000);
  setTimeout(pinPlpInheritedWeights, 4000);
  setTimeout(pinPlpHeroTitleSize, 2000);
  setTimeout(pinPlpHeroTitleSize, 4000);
  setTimeout(pinPdpHeroTitleStyle, 2000);
  setTimeout(pinPdpHeroTitleStyle, 4000);
  setTimeout(pinPdpInfoStyle, 2000);
  setTimeout(pinPdpInfoStyle, 4000);
  /* Watch late MT <link>/<style> and PLP title nodes — ignore our own pin moves. */
  if (typeof MutationObserver === "function") {
    try {
      var moTimer = null;
      var mo = new MutationObserver(function (mutations) {
        if (pinning) return;
        var needsCss = false;
        var needsTitle = false;
        for (var i = 0; i < mutations.length; i++) {
          var nodes = mutations[i].addedNodes;
          for (var j = 0; j < nodes.length; j++) {
            var n = nodes[j];
            if (!n || n.nodeType !== 1) continue;
            if (n.getAttribute && n.getAttribute("data-pw-css")) continue;
            if (n.id === "pw-plp-ranking-lock") continue;
            if (n.id === "pw-site-type-lock") continue;
            var href = (n.tagName === "LINK" && n.getAttribute("href")) || "";
            if (href.indexOf("print-world-blond.vercel.app/") !== -1 && href.indexOf("?v=" + CSS_V) === -1) {
              needsCss = true;
              break;
            }
            if (n.tagName === "STYLE" || n.tagName === "LINK") needsTitle = true;
            var cls = n.classList;
            if (cls && (cls.contains("plp-hero") || cls.contains("plp-hero__title-sm") || cls.contains("plp-hero__title-lg") || cls.contains("pdp-hero") || cls.contains("pdp-hero__title") || cls.contains("pdp-info"))) {
              needsTitle = true;
            }
            if (n.querySelectorAll) {
              var bad = n.querySelectorAll('link[rel="stylesheet"]');
              for (var k = 0; k < bad.length; k++) {
                var h = bad[k].getAttribute("href") || "";
                if (h.indexOf("print-world-blond.vercel.app/") !== -1 && h.indexOf("?v=" + CSS_V) === -1) {
                  needsCss = true;
                  break;
                }
              }
              if (n.querySelector(".plp-hero__title-sm, .plp-hero__title-lg, .plp-hero, .pdp-hero__title, #pdp-title, .pdp-info, style")) {
                needsTitle = true;
              }
            }
            if (needsCss) break;
          }
          if (needsCss) break;
        }
        if (!needsCss && !needsTitle) return;
        if (moTimer) clearTimeout(moTimer);
        moTimer = setTimeout(needsCss ? pinAll : function () {
          markPlpBody();
          pinPlpInheritedWeights();
          pinPlpHeroTitleSize();
          pinPdpHeroTitleStyle();
          pinPdpInfoStyle();
        }, 100);
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
    } catch (e) {}
  }

  function isCartPage() {
    return !!(
      document.querySelector(".cart__parent-area") ||
      document.querySelector(".cart_parent-area")
    );
  }

  function isCheckoutPage() {
    if (document.querySelector(".header__checkout")) return true;
    var p = location.pathname || "";
    return /^\/checkout(\/|$)/.test(p);
  }

  function cartPadPx() {
    return window.matchMedia("(max-width: 959px)").matches ? "90px" : "190px";
  }

  function checkoutPadPx() {
    return window.matchMedia("(max-width: 959px)").matches ? "106px" : "170px";
  }

  function applySystemMainPad() {
    var b = document.body;
    if (!b) return;
    var mains = document.querySelectorAll("main");
    var i;
    if (b.classList.contains("make_confirm")) {
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", "175px", "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
