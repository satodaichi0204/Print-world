<!-- ===== Print World ヘッダー（ページテーマ「ヘッダ」Twig 貼り付け用） ===== -->
<!-- 私たちの fv-header デザイン + MTのカート/ログイン/SPメニュー/ロゴ(wa_top)。 -->
<!-- このTwigが全ページ共通でCSSを読み込む（フッターもこのCSSで描画される）。 -->
<link rel="stylesheet" href="https://print-world-blond.vercel.app/styles.css?v=20260807hdr769lock" data-pw-css="styles.css">
<link rel="stylesheet" href="https://print-world-blond.vercel.app/mobile.css?v=20260807hdr769lock" data-pw-css="mobile.css">
<script>
/* make_confirm / cart: MT headerFix is 70px/50px; our fixed fv-header needs more clearance.
   Also pin Print World CSS so late/stale sheets from HTML blocks cannot snap the layout back. */
(function () {
  var CSS_V = "20260807hdr769lock";
  var CSS_BASE = "https://print-world-blond.vercel.app/";

  function pinPwCss() {
    ["styles.css", "mobile.css"].forEach(function (name) {
      var desired = CSS_BASE + name + "?v=" + CSS_V;
      var links = document.querySelectorAll('link[rel="stylesheet"]');
      var keep = null;
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute("href") || "";
        if (href.indexOf("print-world-blond.vercel.app/" + name) === -1) continue;
        if (href.indexOf("?v=" + CSS_V) !== -1) {
          links[i].setAttribute("data-pw-css", name);
          keep = links[i];
        } else if (links[i].parentNode) {
          /* Remove stale/unversioned duplicates that load after paint and undo fixes */
          links[i].parentNode.removeChild(links[i]);
        }
      }
      if (!keep) {
        keep = document.createElement("link");
        keep.rel = "stylesheet";
        keep.href = desired;
        keep.setAttribute("data-pw-css", name);
      }
      /* Always move current sheet to end of <head> so it wins the cascade */
      (document.head || document.documentElement).appendChild(keep);
    });
  }

  function pinPlpRankingLock() {
    var id = "pw-plp-ranking-lock";
    var s = document.getElementById(id);
    if (!s) {
      s = document.createElement("style");
      s.id = id;
      s.textContent =
        /* Cards locked 769+; banner 679–1024; tablet 426–768 1-up/3-col; phone 320–425 1-up/2-col */
        "@media (min-width: 769px){" +
        ".plp-main .plp-ranking__track .product-card{" +
        "flex:0 0 488px!important;width:488px!important;" +
        "min-width:488px!important;max-width:488px!important;}" +
        ".plp-main .plp-ranking__track .product-chip{font-size:14px!important;}" +
        ".plp-main .plp-ranking__track .product-name{font-size:18px!important;line-height:1.3!important;}" +
        ".plp-main .plp-ranking__track .product-price{font-size:36px!important;}" +
        ".plp-main .plp-ranking__track .product-tags li{font-size:12px!important;}" +
        ".plp-main .plp-ranking__track .plp-rank-badge{font-size:12px!important;}" +
        "}" +
        "@media (min-width: 679px) and (max-width: 1024px){" +
        ".plp-main .plp-ranking{--plp-banner-s:calc(0.72 + 0.28 * (100vw - 679px) / (1024px - 679px));}" +
        ".plp-main .plp-ranking__banner-row{padding-inline:calc(12px + 12px * var(--plp-banner-s))!important;max-width:100%;box-sizing:border-box;}" +
        ".plp-main .plp-ranking__banner{max-width:calc(100% - 8px)!important;width:max-content;" +
        "padding:calc(17px * var(--plp-banner-s)) calc(58px * var(--plp-banner-s))!important;" +
        "margin-left:auto!important;margin-right:auto!important;box-sizing:border-box!important;}" +
        ".plp-main .plp-ranking__banner-title{font-size:calc(24px * var(--plp-banner-s))!important;" +
        "gap:calc(1.4em * var(--plp-banner-s))!important;white-space:nowrap;}" +
        ".plp-main .plp-ranking__banner-part + .plp-ranking__banner-part{font-size:calc(1em + 6px * var(--plp-banner-s))!important;}" +
        "}" +
        "@media (min-width: 426px) and (max-width: 768px){" +
        ".plp-main .plp-ranking{--plp-tab-s:calc(0.84 + 0.16 * (100vw - 426px) / (768px - 426px));}" +
        ".plp-main .plp-ranking__slider{padding:calc(20px * var(--plp-tab-s)) calc(48px * var(--plp-tab-s)) calc(22px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__viewport{overflow:hidden!important;width:100%!important;max-width:100%!important;}" +
        ".plp-main .plp-ranking__track .product-card{" +
        "flex:0 0 100cqw!important;width:100cqw!important;min-width:0!important;max-width:100cqw!important;" +
        "align-items:center!important;gap:calc(22px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__track .plp-rank-card__media{flex:0 0 36%!important;width:36%!important;max-width:36%!important;}" +
        ".plp-main .plp-ranking__track .plp-rank-card__body{flex:0 1 auto!important;width:auto!important;" +
        "max-width:calc(64% - 22px * var(--plp-tab-s))!important;align-items:flex-start!important;justify-content:center!important;}" +
        ".plp-main .plp-ranking__track .product-name{margin:calc(6px * var(--plp-tab-s)) 0 0!important;" +
        "font-size:max(calc(16px * var(--plp-tab-s)),13px)!important;word-break:keep-all!important;overflow-wrap:normal!important;}" +
        ".plp-main .plp-ranking__track .product-price{margin:calc(4px * var(--plp-tab-s)) 0 0!important;" +
        "font-size:max(calc(30px * var(--plp-tab-s)),22px)!important;}" +
        ".plp-main .plp-ranking__track .product-tags{margin:calc(6px * var(--plp-tab-s)) 0 0!important;width:max-content!important;" +
        "grid-template-columns:repeat(2,auto)!important;gap:calc(2px * var(--plp-tab-s)) calc(12px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__track .product-tags li{white-space:nowrap!important;}" +
        ".plp-main .plp-ranking__nav{width:calc(40px * var(--plp-tab-s))!important;height:calc(40px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__nav--prev{left:calc(4px * var(--plp-tab-s))!important;transform:translateY(-50%)!important;}" +
        ".plp-main .plp-ranking__nav--next{right:calc(4px * var(--plp-tab-s))!important;transform:translateY(-50%)!important;}" +
        ".plp-main .plp-subcat__grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;}" +
        ".plp-main .plp-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;}" +
        ".plp-main .plp-ranking__banner{max-width:100%!important;padding:calc(12px * var(--plp-tab-s)) calc(18px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__banner-title{flex-wrap:wrap!important;white-space:normal!important;" +
        "font-size:calc(15px * var(--plp-tab-s))!important;}" +
        "}" +
        "@media (min-width: 320px) and (max-width: 425px){" +
        ".plp-main .plp-ranking{--plp-tab-s:calc(0.78 + 0.06 * (100vw - 320px) / (425px - 320px));}" +
        ".plp-main .plp-ranking__slider{padding:calc(18px * var(--plp-tab-s)) calc(44px * var(--plp-tab-s)) calc(20px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__viewport{overflow:hidden!important;width:100%!important;max-width:100%!important;}" +
        ".plp-main .plp-ranking__track .product-card{" +
        "flex:0 0 100cqw!important;width:100cqw!important;min-width:0!important;max-width:100cqw!important;}" +
        ".plp-main .plp-ranking__nav{width:calc(36px * var(--plp-tab-s))!important;height:calc(36px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__nav--prev{left:calc(4px * var(--plp-tab-s))!important;transform:translateY(-50%)!important;}" +
        ".plp-main .plp-ranking__nav--next{right:calc(4px * var(--plp-tab-s))!important;transform:translateY(-50%)!important;}" +
        ".plp-main .plp-subcat__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}" +
        ".plp-main .plp-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}" +
        ".plp-main .plp-ranking__banner{max-width:100%!important;padding:calc(12px * var(--plp-tab-s)) calc(16px * var(--plp-tab-s))!important;}" +
        ".plp-main .plp-ranking__banner-title{flex-wrap:wrap!important;white-space:normal!important;" +
        "font-size:max(calc(14px * var(--plp-tab-s)),12px)!important;}" +
        "}" +
        /* Cart main clearance — matches DevTools-tuned headerFix values */
        "html body:has(.cart__parent-area) main,html body:has(.cart_parent-area) main{" +
        "padding-top:190px!important;margin-top:0!important;}" +
        "@media only screen and (max-width:959px){" +
        "html body:has(.cart__parent-area) main,html body:has(.cart_parent-area) main{" +
        "padding-top:90px!important;}" +
        "}" +
        /* Checkout (届け先等) — DevTools-tuned: 170px / 106px ≤959 */
        "html body:has(.header__checkout) main{" +
        "padding-top:170px!important;margin-top:0!important;}" +
        "@media only screen and (max-width:959px){" +
        "html body:has(.header__checkout) main{padding-top:106px!important;}" +
        "}";
    }
    (document.head || document.documentElement).appendChild(s);
  }

  function pinAll() {
    pinPwCss();
    pinPlpRankingLock();
  }

  pinAll();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", pinAll);
  }
  window.addEventListener("load", pinAll);
  setTimeout(pinAll, 0);
  setTimeout(pinAll, 300);
  setTimeout(pinAll, 1000);

  function isCartPage() {
    return !!(
      document.querySelector(".cart__parent-area") ||
      document.querySelector(".cart_parent-area")
    );
  }

  function isCheckoutPage() {
    if (document.querySelector(".header__checkout")) return true;
    var p = location.pathname || "";
    return /^\/checkout(\/|$)/.test(p);
  }

  function cartPadPx() {
    return window.matchMedia("(max-width: 959px)").matches ? "90px" : "190px";
  }

  function checkoutPadPx() {
    return window.matchMedia("(max-width: 959px)").matches ? "106px" : "170px";
  }

  function applySystemMainPad() {
    var b = document.body;
    if (!b) return;
    var mains = document.querySelectorAll("main");
    var i;
    if (b.classList.contains("make_confirm")) {
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", "175px", "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
      }
      return;
    }
    if (isCartPage()) {
      var cartPad = cartPadPx();
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", cartPad, "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
      }
      return;
    }
    if (isCheckoutPage()) {
      var chkPad = checkoutPadPx();
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", chkPad, "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
      }
    }
  }
  applySystemMainPad();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", applySystemMainPad);
  }
  window.addEventListener("load", applySystemMainPad);
  window.addEventListener("resize", applySystemMainPad);
  setTimeout(applySystemMainPad, 0);
  setTimeout(applySystemMainPad, 200);
  setTimeout(applySystemMainPad, 800);
})();
</script>
