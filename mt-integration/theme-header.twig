      return;
    }
    if (isCartPage()) {
      var cartPad = cartPadPx();
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", cartPad, "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
      }
      return;
    }
    if (isCheckoutPage()) {
      var chkPad = checkoutPadPx();
      for (i = 0; i < mains.length; i++) {
        mains[i].style.setProperty("padding-top", chkPad, "important");
        mains[i].style.setProperty("margin-top", "0px", "important");
      }
    }
  }
  applySystemMainPad();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", applySystemMainPad);
  }
  window.addEventListener("load", applySystemMainPad);
  window.addEventListener("resize", applySystemMainPad);
  setTimeout(applySystemMainPad, 0);
  setTimeout(applySystemMainPad, 200);
  setTimeout(applySystemMainPad, 800);
})();
</script>
